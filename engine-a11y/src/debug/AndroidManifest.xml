<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- 仅 debug 构建：通过 DEBUG_DUMP 广播录制快照，extra name 为快照名称 -->
        <receiver
            android:name="com.sentinel.a11y.debug.SnapshotDumper"
            android:exported="true">
            <intent-filter>
                <action android:name="com.sentinel.a11y.DEBUG_DUMP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
